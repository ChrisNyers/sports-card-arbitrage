# Copy to .env and fill in when real API access is available.
# Any source whose credential below is unset falls back to its Mock adapter.

EBAY_APP_ID=
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PSA_API_KEY=
NEWS_API_KEY=

# Optional: enable email alerts (silently skipped if unset)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
